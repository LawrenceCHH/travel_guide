{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://travel-plan.local/schemas/food.schema.json",
  "title": "food.json",
  "description": "美食素材庫。依 references/sections/09_materials.md 的欄位規範與合法列舉值。輸出約定見同檔 §7.2。",
  "type": "object",
  "required": ["version", "areas"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/area" }
    }
  },
  "definitions": {
    "area": {
      "type": "object",
      "required": ["id", "picks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "須與 spots.json 的 area id 對應。" },
        "picks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/pick" }
        }
      }
    },
    "pick": {
      "type": "object",
      "required": [
        "id", "name", "category", "audience", "near_spot", "walk_min",
        "price_band", "signature", "why", "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "美食項目代碼，英數與底線。" },
        "name": { "type": "string", "description": "店名/攤位名稱。" },
        "name_local": { "type": "string", "description": "當地語言原文名稱，選填。" },
        "category": {
          "type": "string",
          "enum": ["正餐", "小吃", "咖啡甜點", "伴手禮"],
          "description": "合法值定義於 references/sections/09_materials.md §列舉值。"
        },
        "audience": {
          "type": "string",
          "enum": ["tourist", "local"],
          "description": "此項目偏觀光客名店還是當地人私房。"
        },
        "near_spot": {
          "type": "string",
          "description": "參照 spots.json 同一 area 內某景點的 id（參照完整性由 validate_materials 檢查）。"
        },
        "walk_min": { "type": "integer", "minimum": 0, "description": "從 near_spot 步行到此的分鐘數。" },
        "price_band": { "type": "string", "description": "價位帶，如 ₩／₩₩／₩₩₩ 或當地慣用符號。" },
        "signature": { "type": "string", "description": "招牌菜。" },
        "why": { "type": "string", "description": "推薦理由，含為何適合此同伴。" },
        "caution": { "type": "string", "description": "提醒事項，如排隊時間、替代方案，選填。" },
        "rainy_day_ok": { "type": "boolean", "description": "是否適合作為雨天/公休時的室內歇腳美食選項，選填。" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/source" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "site", "url", "published", "tier"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "site": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "published": { "type": "string", "format": "date" },
        "tier": { "type": "string", "enum": ["official", "platform", "blogger"] }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "areas": [
        {
          "id": "gyeongbok",
          "picks": [
            {
              "id": "cafe_onion_anguk",
              "name": "Cafe Onion 安國店",
              "name_local": "카페 어니언 안국점",
              "category": "咖啡甜點",
              "audience": "tourist",
              "near_spot": "gyeongbokgung",
              "walk_min": 8,
              "price_band": "₩₩",
              "signature": "팡도르（法多蛋糕）",
              "why": "韓屋改建的網美咖啡廳，適合逛完古蹟後歇腳。",
              "caution": "假日排隊 40 分以上，替代方案 O'sulloc 仁寺洞店",
              "sources": [
                {
                  "title": "安國站韓屋咖啡廳 Cafe Onion 探訪",
                  "site": "首爾旅遊部落客小美",
                  "url": "https://example-blog.com/seoul/cafe-onion-anguk",
                  "published": "2026-05-02",
                  "tier": "blogger"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
