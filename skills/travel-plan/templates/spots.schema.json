{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://travel-plan.local/schemas/spots.schema.json",
  "title": "spots.json",
  "description": "景點素材庫。依 references/sections/09_materials.md 的欄位規範與合法列舉值。輸出約定（欄位順序、巢狀層數、縮排）見同檔 §7.2。",
  "type": "object",
  "required": ["version", "destination", "last_verified", "areas"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "schema 版本，目前固定為 1。"
    },
    "destination": {
      "type": "string",
      "description": "目的地名稱，需與 trip_context.json 的 destination 一致。"
    },
    "last_verified": {
      "type": "string",
      "format": "date",
      "description": "整份素材庫最後一次檢索/覆核的日期，YYYY-MM-DD。"
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/area" }
    }
  },
  "definitions": {
    "area": {
      "type": "object",
      "required": ["id", "name", "summary", "nearest_station", "spots"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "區域代碼，英數與底線，供 food.json 的 area id 對照。" },
        "name": { "type": "string", "description": "區域顯示名稱。" },
        "summary": { "type": "string", "description": "一句話描述這個大區域的性格。" },
        "nearest_station": { "type": "string", "description": "區域代表車站/樞紐，含線路編號。" },
        "nearby_areas": {
          "type": "array",
          "items": { "$ref": "#/definitions/nearby_area" },
          "description": "選填，非窮舉。只記實際會拿來排半天/整天行程的鄰近大區域，不必列出與所有其他 area 的配對。"
        },
        "spots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/spot" }
        }
      }
    },
    "nearby_area": {
      "type": "object",
      "required": ["area_id", "travel_min", "mode"],
      "additionalProperties": false,
      "properties": {
        "area_id": { "type": "string", "description": "另一個 area 的 id（須存在於同一 areas 陣列中）。" },
        "travel_min": { "type": "integer", "minimum": 0, "description": "移動時間（分鐘），須可回溯到 05_transport.md 已查證的資料，不得憑空估算。" },
        "mode": { "type": "string", "description": "移動方式，如「地鐵」「計程車」「步行」。" }
      }
    },
    "spot": {
      "type": "object",
      "required": [
        "id", "name", "category", "audience", "why", "duration_min",
        "friendliness", "open_hours", "booking_required", "rainy_day_ok", "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "景點代碼，英數與底線，供 food.json 的 near_spot 參照。" },
        "name": { "type": "string", "description": "景點中文/慣用顯示名稱。" },
        "name_local": { "type": "string", "description": "當地語言原文名稱，選填。" },
        "category": {
          "type": "string",
          "enum": ["文化古蹟", "自然景觀", "購物商圈", "網美打卡", "體驗活動", "室內歇腳"],
          "description": "合法值定義於 references/sections/09_materials.md §列舉值。"
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["tourist_must", "local_favorite"] },
          "description": "可並列，例如同時是觀光客必去也是當地人推薦。"
        },
        "why": { "type": "string", "description": "推薦理由，一到兩句。" },
        "duration_min": { "type": "integer", "minimum": 1, "description": "建議停留分鐘數。" },
        "friendliness": {
          "type": "object",
          "required": ["score", "notes"],
          "additionalProperties": false,
          "properties": {
            "score": { "type": "integer", "minimum": 1, "maximum": 5, "description": "同伴友善度評分，滿分 5 星。" },
            "notes": { "type": "string", "description": "友善特徵或雷區說明。" }
          }
        },
        "open_hours": { "type": "string", "description": "營業/開放時間，如 09:00-18:00。" },
        "closed_on": { "type": "string", "description": "公休日，選填。" },
        "fee": { "type": "string", "description": "門票/費用說明，選填。" },
        "booking_required": { "type": "boolean", "description": "是否需事先預約/訂位，供 01 的訂位清單引用。" },
        "rainy_day_ok": { "type": "boolean", "description": "是否適合作為雨天/公休/排隊過長時的 Plan B。每個 area 至少要有 1 個 true。" },
        "best_time_notes": {
          "type": "string",
          "description": "選填。只有這個景點是時間敏感型（看日出/日落/潮汐等）、且查資料時剛好看到具體建議時段才填，不必為每個景點特地查一次。例：「日落前後最佳，約17:30-18:30」。"
        },
        "nearby_spots": {
          "type": "array",
          "items": { "$ref": "#/definitions/nearby_spot" },
          "description": "選填，非窮舉，單向不要求對稱。只記同一 area 內走路可達、有查到具體分鐘數的其他景點，不必每個景點互相補登。"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/source" }
        }
      }
    },
    "nearby_spot": {
      "type": "object",
      "required": ["id", "walk_min"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "同一 area 內另一個景點的 id。" },
        "walk_min": { "type": "integer", "minimum": 0, "description": "步行分鐘數。" }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "site", "url", "published", "tier"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "description": "文章標題。" },
        "site": { "type": "string", "description": "作者或站名。" },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "深層網址，去掉 domain 後路徑不可為空（見 research_rules.md §1）。"
        },
        "published": { "type": "string", "format": "date", "description": "來源發布/更新日期，YYYY-MM-DD。超過 1 年需標記，超過 2 年不合格（見 research_rules.md §6）。" },
        "tier": {
          "type": "string",
          "enum": ["official", "platform", "blogger"],
          "description": "來源分級，定義見 research_rules.md §5。"
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "destination": "韓國首爾",
      "last_verified": "2026-09-09",
      "areas": [
        {
          "id": "gyeongbok",
          "name": "景福宮・三清洞",
          "summary": "宮殿古蹟與韓屋巷弄交織的文青散步區。",
          "nearest_station": "景福宮站 3 號線",
          "spots": [
            {
              "id": "gyeongbokgung",
              "name": "景福宮",
              "name_local": "경복궁",
              "category": "文化古蹟",
              "audience": ["tourist_must"],
              "why": "朝鮮王朝正宮，規模最大、最具代表性的古蹟。",
              "duration_min": 120,
              "friendliness": { "score": 4, "notes": "石板路長、部分區域無遮蔽，夏季注意防曬。" },
              "open_hours": "09:00-18:00",
              "closed_on": "週二",
              "fee": "成人 3000 KRW",
              "booking_required": false,
              "rainy_day_ok": false,
              "sources": [
                {
                  "title": "景福宮參觀資訊與守衛交接儀式時間",
                  "site": "韓國觀光公社",
                  "url": "https://korean.visitkorea.or.kr/example/gyeongbokgung-guide",
                  "published": "2026-03-11",
                  "tier": "official"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
